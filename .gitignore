# Basic .gitignore for a Python project

# Python cache and compiled files
__pycache__/
*.py[cod]
*.pyc

# Virtual environments
venv/
.venv/
env/

# Local environment files (secrets)
.env

# IDE folders
.vscode/
.idea/

# macOS / Windows
.DS_Store
Thumbs.db

# Keep assets/ tracked (images, sounds, etc.)
# If you want to ignore large source files later, add them here
